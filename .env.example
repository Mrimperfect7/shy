# ============================================================
# SHYN.ISH Luxury 3D E-Commerce Environment Configuration
# ============================================================

# Database Configuration (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://user:password@host:port/database?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:password@host:port/database"

# Authentication & Session Security
SESSION_SECRET="your_super_secret_32_character_string_for_jwt"

# Storefront URL
NEXT_PUBLIC_SITE_URL="https://shynish.com"

# Razorpay Payment Gateway (Test or Live keys)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# Logistics & Cash on Delivery
# By default COD is disabled as specified in SHYN.ISH Instagram profile
NEXT_PUBLIC_COD_ENABLED="false"

# Customer Care & WhatsApp Direct Order
WHATSAPP_NUMBER="919876543210"

# Analytics & Meta Conversion Tracking
NEXT_PUBLIC_META_PIXEL_ID="your_meta_pixel_id"
META_ACCESS_TOKEN="your_meta_conversions_api_access_token"
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Email Delivery (SMTP / Resend)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=care@shynish.com
# SMTP_PASS=your_app_password
# EMAIL_FROM="SHYN.ISH <care@shynish.com>"

# ============================================================
# AI Jewelry Virtual Try-On Configuration
# ============================================================
# 1. Google Gemini 2.0 & Google Imagen 3 (Recommended)
# Get your API key from Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY="your_gemini_api_key_here"

# Try-on mode for Gemini:
# - "imagen3": Generates photorealistic high-fashion jewelry editorial using Google Imagen 3 (imagen-3.0-generate-002)
# - "gemini_vision": Uses Gemini 2.0 Flash (gemini-2.0-flash) multimodal vision to detect anatomical landmarks on any user selfie with 100% jewelry fidelity
GEMINI_TRYON_MODE="imagen3"

# 2. Alternative External AI Providers (Fal.ai / Replicate)
# TRYON_API_URL="https://api.fal.ai/v1/run/fal-ai/fashn-tryon"
# TRYON_API_KEY="your_fal_key_here"
